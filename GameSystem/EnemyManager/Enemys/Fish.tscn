[sub_resource type="GDScript" id="GDScript_70euq"]
script/source = "extends MoveManager

@onready var impact = %Impact

func _physics_process(delta: float) -> void:
	if current_phase == 0 \\
	and impact.finish_cooldown():
		switch_phase(1)
		target.set_collision_mask_value(1, true)
		
	elif current_phase == 1:
		var collision = target.get_last_slide_collision()
		if collision \\
		and collision.get_collider() is Player:
			impact.start_cooldown()
			switch_phase(0)
			target.set_collision_mask_value(1, false)
"

